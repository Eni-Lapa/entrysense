# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_FORMAT=pretty
# At least 16 characters. The sample value is rejected when NODE_ENV=production.
API_KEY=dev-api-key-change-me
# Used to decide what "today" and "yesterday" mean.
TIME_ZONE=Europe/Berlin

# Storage: "memory" (no setup) or "postgres" (docker compose up -d && npm run db:migrate)
STORAGE=memory
DATABASE_URL=postgresql://entrysense:entrysense@localhost:5432/entrysense

# LLM provider: "mock" (offline, deterministic) or "anthropic"
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Tracing (optional). Leave the keys empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# Send note content to Langfuse. Off by default because notes are health data.
TRACE_CONTENT=false

# OpenTelemetry (optional). Set an OTLP/HTTP endpoint to export traces; leave empty to disable.
# Local Jaeger:  docker compose --profile observability up -d, then http://localhost:4318
# Dynatrace:     https://<environment-id>.live.dynatrace.com/api/v2/otlp
#                with OTEL_EXPORTER_OTLP_HEADERS=Authorization=Api-Token <token with openTelemetryTrace.ingest>
OTEL_SERVICE_NAME=entrysense
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
