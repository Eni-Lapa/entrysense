{
  "name": "entrysense",
  "version": "0.1.0",
  "private": true,
  "description": "Typed Express API that turns free-text health notes into validated data with LLM structured outputs and answers questions through tool calling.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "tsx eval/run.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/infrastructure/persistence/migrate.ts",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage",
    "db:check": "drizzle-kit check",
    "db:migrate:dist": "node dist/infrastructure/persistence/migrate.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "~0.45.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "langfuse": "^3.39.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.2",
    "drizzle-kit": "~0.31.11",
    "eslint": "^10.11.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
